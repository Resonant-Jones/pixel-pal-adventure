MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=
MC_AUTH=offline
PRIMARY_PLAYER=SageTheMage5388
MC_PRIMARY_PLAYER=SageTheMage5388
# Everyone who may talk to the companion. The bot and PRIMARY_PLAYER are added
# automatically. Ops (ops.json) are DERIVED from this list on bootstrap, so a
# name change here cannot leave a stale, dead account on the server again.
# Bedrock gamertags are written bare here; the Floodgate "." prefix is added by
# the bootstrap, because that is the name Paper actually sees.
COMPANION_PLAYERS=PandaNuggetz120,SageTheMage5388
MC_BOT_USERNAME=Guardian
MC_THREAD_ID=
MC_RESPOND_TO_ALL=false
# Who an UNAPPROVED player is — anyone who joins who is NOT in
# COMPANION_PLAYERS. They are never given the full companion.
#   bounded  (default) they get a warm reply, but with none of the family's
#            memories, saved places, or abilities. Every exchange is logged so
#            the parent can review it.
#   ignore   they get silence, and are still logged.
GUARDIAN_GUEST_MODE=bounded
MC_FOLLOW_DISTANCE=2

COMPANION_ROLE=AI companion for Sage
COMPANION_PERSONALITY=Warm, observant, concise, practical, and grounded in the Minecraft world.

# Provider: minimax | deepseek | groq | ollama
# deepseek + deepseek-flash is the verified low-latency setup for in-game replies.
LLM_PROVIDER=deepseek

# DeepSeek uses the OpenAI-compatible client path, but MUST ship with thinking
# disabled: deepseek-flash is a reasoning model, and reasoning tokens otherwise
# consume max_tokens and return empty content.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.8
DEEPSEEK_MAX_TOKENS=3000
DEEPSEEK_TIMEOUT_MS=30000
# disabled | enabled. "enabled" buys depth at the cost of in-game latency.
DEEPSEEK_THINKING=disabled

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_TEMPERATURE=0.6
MINIMAX_MAX_TOKENS=220
MINIMAX_TIMEOUT_MS=30000

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3-32b
GROQ_TEMPERATURE=0.6
GROQ_MAX_TOKENS=220
GROQ_TIMEOUT_MS=30000

OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
OLLAMA_TEMPERATURE=0.6
OLLAMA_MAX_TOKENS=220
OLLAMA_TIMEOUT_MS=30000

# Port 8001, not 8000: another local service already owns 8000 on this machine.
SURREAL_URL=http://127.0.0.1:8001
SURREAL_NAMESPACE=minecraft
SURREAL_DATABASE=companion
SURREAL_USERNAME=root
SURREAL_PASSWORD=secret

AGENT_MEMORY_WINDOW=12
AGENT_EVENT_WINDOW=6
AGENT_SUMMARY_INTERVAL=24
AGENT_SUMMARY_WINDOW=24
AGENT_SUMMARY_CONTEXT_LIMIT=3
AGENT_MAX_PENDING_TURNS=4
AGENT_REFLEX_INTERVAL_MS=5000
AGENT_REFLEX_WORKER_INTERVAL_MS=1000
AGENT_BUILD_WORKER_INTERVAL_MS=1000
AGENT_REFLEX_GLOBAL_COOLDOWN_MS=60000
AGENT_REFLEX_TRIGGER_COOLDOWN_MS=180000
AGENT_REFLEX_IDLE_THRESHOLD_MS=90000
ALLOW_AUTO_GIVE_BUILD_MATERIALS=false
AGENT_BUILD_DEBUG=false

AGENT_RETRY_MAX_ATTEMPTS=3
AGENT_RETRY_BASE_DELAY_MS=500
AGENT_RETRY_MAX_DELAY_MS=5000
AGENT_RETRY_JITTER=0.25
AGENT_RETRY_GRAPH_FROM_ATTEMPT=2
AGENT_RETRY_LOOP_THRESHOLD=3

MC_RECONNECT_MAX_ATTEMPTS=5
MC_RECONNECT_BASE_DELAY_MS=1000
MC_RECONNECT_MAX_DELAY_MS=15000
MC_RECONNECT_JITTER=0.25

# --- Stack launcher (scripts/startStack.js) ---
# PAPER_PORT/SURREAL_PORT must agree with MC_PORT/SURREAL_URL above.
# startStack refuses to boot a second Guardian if CONTROL_PORT is occupied.
PAPER_PORT=25565
SURREAL_PORT=8001
BEDROCK_PORT=19132
CONTROL_PORT=8787

# --- Voice ---
# Off unless you turn it on. When enabled, every line Guardian says is
# synthesised to audio and published for a companion app to carry.
#
# VOICE_ENABLED=false
# VOICE_ID=English_FriendlyPerson
# VOICE_TTS_MODEL=speech-2.8-turbo
# VOICE_SPEED=1.05
# VOICE_ASR_MODEL=asr-1.0
# VOICE_MAX_CHARS=220
# VOICE_TIMEOUT_MS=30000

# --- Companion app (the voice link that sits next to the game) ---
# The companion app opens CoreAudio, so it must run OUTSIDE the agent
# sandbox: `./scripts/runCompanion.sh`. The agent talks to it over a
# WebSocket and a handful of HTTP calls.
#
# Device indices are avfoundation's. Run `node scripts/startCompanion.js
# --check` to list the ones on this machine.
#
# The INPUT is where the player's voice comes from. The OUTPUT is where
# Guardian's voice goes, and it is the transport: point it at a virtual
# device (BlackHole) when Bedrock Voice Chat is wired up, so the voice
# reaches the voice client's microphone input instead of the speakers.
#
# COMPANION_AUDIO_INPUT=0
# COMPANION_AUDIO_OUTPUT=0
# COMPANION_APP_PORT=8788
# COMPANION_DEFAULT_SPEAKER=Panda_Nuggetz
# COMPANION_VAD_THRESHOLD_DB=-45
# COMPANION_VAD_HANGOVER_MS=700
